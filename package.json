{
  "name": "botctl",
  "version": "0.1.0",
  "description": "A lightweight framework for orchestrating AI agents",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "botctl": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/cli/index.ts",
    "chat": "bun run src/cli/index.ts chat",
    "gateway": "bun run src/cli/index.ts gateway",
    "onboard": "bun run src/cli/index.ts onboard",
    "status": "bun run src/cli/index.ts status",
    "build": "bun build src/cli/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
